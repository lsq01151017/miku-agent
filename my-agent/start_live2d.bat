@echo off
rem ============================================================
rem  Hatsune Miku Agent + Live2D Avatar  (Lv1 + Lv2 + Lv3)
rem
rem  双击这个文件就行。它会：
rem    1) 检查 / 启动 Ollama
rem    2) 启动 Agent 与 Live2D 表现层
rem    3) 服务真正就绪后，由程序自己打开浏览器（不在这里猜时机）
rem
rem  为什么不在这里开浏览器：如果 Ollama 需要先启动，主程序会等几十秒，
rem  这时提前打开的页面会报"连不上服务"。交给程序在就绪后打开才可靠。
rem ============================================================
chcp 65001 >nul
setlocal
cd /d "%~dp0"

echo ============================================================
echo   Miku Agent + Live2D
echo ============================================================
echo   稍后浏览器会自动打开 Live2D 画面。
echo   如果没自动打开，看下面程序打印的地址，手动访问即可
echo   （默认是 http://127.0.0.1:8765/ ，端口被占用时会自动换）。
echo.
echo   打开后你可以：
echo     - 看到她的表情随内部情绪变化（害羞会脸红、开心会唱歌 / 掏葱）
echo     - 她在查资料时摆出"圈圈"，说话时嘴会动
echo     - 鼠标移动时她的视线会跟着你
echo     - 左下角面板显示实时情绪数值；右下角可缩放、可试表情
echo.
echo   注意：只能用 http:// 地址访问，不要直接双击 index.html
echo.

call "%~dp0start.bat" --avatar --avatar-port 8765

endlocal
