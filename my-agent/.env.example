# ============================================================
#  Heart Heart Heart  —  Lv1 + Lv2 Agent 配置
#  本文件含密钥，已在 .gitignore 中排除，请勿提交或分享
# ============================================================

# --- Lv2: 第三方兼容端点（工具调用 / 复杂推理）---
# 请在此填写你的 API Key（不要硬编码进 .py 文件）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://r.dis.115.zone/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash

# --- Lv1: Ollama 本地模型（人格对话 / 流式输出）---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:14b
# 本地模型上下文窗口（人设+记忆+历史都塞这里；太小会挤掉记忆，太大会变慢）
AGENT_NUM_CTX=6144

# --- 会话与身份 ---
# 每个 session_id 拥有独立的对话历史；记忆与情绪状态跨 session 持续存在
AGENT_SESSION_ID=main
# 留空则完全由记忆系统推断用户称呼
AGENT_USER_NAME=

# --- Lv1: 上下文管理 ---
# 最近多少轮对话逐字保留（1 轮 = 用户 1 条 + 角色 1 条）
AGENT_HISTORY_WINDOW=8
# 逐字窗口之外累积多少轮后触发压缩（总结成摘要并写入记忆）
AGENT_SUMMARY_TRIGGER=12
# 本地模型采样参数
AGENT_TEMPERATURE=0.8
AGENT_TOP_P=0.9
# 单次回复最大 token（注意：R1 的推理过程也占用这个预算，太小会导致正文被截断）
AGENT_MAX_TOKENS=700

# --- Lv2: 记忆检索 ---
# 每次注入上下文的记忆条数
AGENT_RECALL_TOP_K=6
# 记忆衰减：多少天未访问则开始降低重要度
AGENT_MEMORY_HALFLIFE_DAYS=30
# 每多少轮做一次"记忆巩固"（反思：把零碎对话总结成高阶记忆）
AGENT_REFLECTION_EVERY_TURNS=20

# --- Lv2: 行动 ---
# 单次用户输入允许的最大工具调用轮数
AGENT_TOOL_MAX_ITERATIONS=4
AGENT_WEATHER_TIMEOUT=8
# 是否允许模型直接执行带副作用的工具（Lv3 预留：建议保持 false 走确认流程）
AGENT_ALLOW_SIDE_EFFECTS=false

# --- 行为（创新点）---
# 工具拟人化包装：API 只负责查数据，最终回复由本地模型包装成 Miku 的语气
AGENT_REVOICE_WITH_LOCAL=true
# 主动消息：离开超过 N 小时，下次见面她会先表达寂寞
AGENT_PROACTIVE_HOURS=24

# --- 不预设任何关于你的事 ---
# 还不知道你名字时先问一次，而不是假设一个称呼
AGENT_ASK_NAME_FIRST=true
# 在得知名字之前用的临时称呼（想换就改这里；留空则不用任何称呼）
AGENT_USER_TITLE=制作人
# 一次性查询结果（天气/时间/计算）是否进长期记忆：
#   none=不进（推荐，只留在对话历史与审计日志）/ transient=进但1天过期 / always=永久
AGENT_REMEMBER_TOOL_RESULTS=none

# --- 路由模式 ---
# hybrid=关键词快路径 + 未命中交给模型判断（推荐，不依赖预设词表）
# keyword=纯关键词（零 API 成本） / model=全部由模型判断（最不依赖预设）
AGENT_ROUTER_MODE=hybrid

# --- 情绪状态 ---
# lexicon = 规则词典（快、可解释）；llm = 调用模型判断（慢，Lv3 预留）
AGENT_AFFECT_ANALYZER=lexicon
# 情绪向基线回落所需时间（小时）
AGENT_EMOTION_DECAY_HOURS=6

# --- 可观测性 ---
AGENT_LOG_ECHO=false
AGENT_LOG_LEVEL=debug
AGENT_STREAM=true
